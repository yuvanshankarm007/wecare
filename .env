# Leave blank to run in MOCK mode (no network needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Examples:
# Fireworks (AMD GPUs):  OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#                        OPENAI_MODEL=accounts/fireworks/models/<model>
# AMD Developer Cloud vLLM: OPENAI_BASE_URL=http://<host>:8000/v1
#                        OPENAI_MODEL=<served-model-name>